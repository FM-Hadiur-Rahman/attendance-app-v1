        {/* 🔹 Scroll list */}
        <ScrollView
          style={{ marginTop: 20, marginBottom: "15%" }}
          showsVerticalScrollIndicator={false}
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={onRefresh}
              colors={[colors.primary]}
            />
          }
        >
          {/* Empty State */}